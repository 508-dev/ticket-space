# Copy to apps/android/keystore.properties (gitignored) for local release builds.
# A complete local file wins over TICKETSPACE_KEYSTORE_FILE /
# TICKETSPACE_KEYSTORE_PASSWORD / TICKETSPACE_KEY_ALIAS / TICKETSPACE_KEY_PASSWORD.
# CI passes those environment variables instead. With neither, release is unsigned.
# storeFile is absolute or relative to apps/android, not the app module.
# Back up the real key offline: changing it prevents updates of installed APKs.
# See docs/deployment.md -> Releases.
storeFile=/absolute/path/to/release.keystore
storePassword=changeme
keyAlias=ticketspace
# PKCS12 keystores (keytool's default) use the same store and key password.
keyPassword=changeme
