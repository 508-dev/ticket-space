{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!apps/android",
      "!**/build",
      "!**/dist",
      "!**/.gradle",
      "!**/.venv",
      "!**/.claude",
      "!**/.context",
      "!**/node_modules",
      "!**/pb_data"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": "warn"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "overrides": [
    {
      "includes": ["apps/pocketbase/pb_migrations/**", "apps/pocketbase/pb_hooks/**"],
      "javascript": {
        "globals": [
          "migrate",
          "Collection",
          "Record",
          "DateTime",
          "onRecordCreateRequest",
          "onRecordUpdateRequest",
          "$app",
          "$os"
        ]
      }
    },
    {
      "includes": ["apps/pocketbase/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
